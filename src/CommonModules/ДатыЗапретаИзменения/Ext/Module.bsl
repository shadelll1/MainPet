///////////////////////////////////////////////////////////////////////////////////////////////////////
// Запрет изменения документов закрытого периода.
// Проверка подключена подпиской на событие ПроверкаДатыЗапретаИзменения (ПередЗаписью всех документов),
// поэтому новые документы защищены автоматически - достаточно добавить их в источники подписки.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает дату запрета изменения из константы.
//
// Возвращаемое значение:
//  Дата - дата, по которую (включительно) изменение запрещено; пустая дата - запрета нет.
//
Функция ДатаЗапретаИзменения() Экспорт

	Возврат Константы.ДатаЗапретаИзменения.Получить();

КонецФункции

// Проверяет, попадает ли дата в закрытый период.
//
// Параметры:
//  Дата - Дата - проверяемая дата.
//  ДатаЗапрета - Дата, Неопределено - дата запрета; если не передана, читается из константы.
//
// Возвращаемое значение:
//  Булево - Истина, если изменение данных на эту дату запрещено.
//
Функция ДатаВЗакрытомПериоде(Дата, Знач ДатаЗапрета = Неопределено) Экспорт

	Если ДатаЗапрета = Неопределено Тогда
		ДатаЗапрета = ДатаЗапретаИзменения();
	КонецЕсли;

	Возврат ЗначениеЗаполнено(ДатаЗапрета) И Дата <= КонецДня(ДатаЗапрета);

КонецФункции

// Обработчик подписки ПроверкаДатыЗапретаИзменения.
// Запрещает запись документа, если закрытому периоду принадлежит его новая дата
// или дата, с которой он сейчас записан в базе (перенос документа из закрытого периода).
//
// Параметры:
//  Источник - ДокументОбъект - записываемый документ.
//  Отказ - Булево - признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПроверитьДатуЗапретаПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ДатаЗапрета = ДатаЗапретаИзменения();
	Если Не ЗначениеЗаполнено(ДатаЗапрета) Тогда
		Возврат;
	КонецЕсли;

	ПроверяемыеДаты = Новый Массив;
	ПроверяемыеДаты.Добавить(Источник.Дата);
	Если Не Источник.ЭтоНовый() Тогда
		ПроверяемыеДаты.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Дата"));
	КонецЕсли;

	Для Каждого ПроверяемаяДата Из ПроверяемыеДаты Цикл
		Если ДатаВЗакрытомПериоде(ПроверяемаяДата, ДатаЗапрета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Период по %1 закрыт для изменений. Документ %2 от %3 не может быть записан.'"),
					Формат(ДатаЗапрета, "ДЛФ=D"), Источник.Метаданные().Синоним, Формат(ПроверяемаяДата, "ДЛФ=D")),
				Источник.Ссылка, "Дата", "Объект", Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
