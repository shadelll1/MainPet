///////////////////////////////////////////////////////////////////////////////////////////////////////
// Проверки реквизитов контрагентов. Модуль доступен на клиенте и на сервере,
// поэтому проверку можно выполнить и в форме, без серверного вызова.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет ИНН: длину (10 цифр для организации, 12 - для ИП и физического лица)
// и контрольные разряды по алгоритму ФНС.
//
// Параметры:
//  ИНН - Строка - проверяемый ИНН.
//  ЭтоЮрЛицо - Булево - Истина для организации (10 цифр), Ложь для ИП и физ. лица (12 цифр).
//  ТекстОшибки - Строка - выходной параметр: причина, по которой ИНН не прошел проверку.
//
// Возвращаемое значение:
//  Булево - Истина, если ИНН корректен.
//
Функция ИННСоответствуетТребованиям(Знач ИНН, ЭтоЮрЛицо, ТекстОшибки = "") Экспорт

	ИНН = СокрЛП(ИНН);
	ТребуемаяДлина = ?(ЭтоЮрЛицо, 10, 12);

	Если СтрДлина(ИНН) <> ТребуемаяДлина Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'ИНН должен состоять из %1 цифр'"), ТребуемаяДлина);
		Возврат Ложь;
	КонецЕсли;

	Если Не СтрокаСостоитТолькоИзЦифр(ИНН) Тогда
		ТекстОшибки = НСтр("ru = 'ИНН должен содержать только цифры'");
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоЮрЛицо Тогда
		КонтрольныеРазрядыВерны =
			КонтрольнаяЦифра(ИНН, "2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 10, 1));
	Иначе
		КонтрольныеРазрядыВерны =
			КонтрольнаяЦифра(ИНН, "7,2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 11, 1))
			И КонтрольнаяЦифра(ИНН, "3,7,2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 12, 1));
	КонецЕсли;

	Если Не КонтрольныеРазрядыВерны Тогда
		ТекстОшибки = НСтр("ru = 'Неверные контрольные разряды ИНН'");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Проверяет КПП: 9 символов, пятый и шестой могут быть цифрами или заглавными латинскими буквами.
//
// Параметры:
//  КПП - Строка - проверяемый КПП.
//  ТекстОшибки - Строка - выходной параметр с описанием ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если КПП корректен.
//
Функция КППСоответствуетТребованиям(Знач КПП, ТекстОшибки = "") Экспорт

	КПП = СокрЛП(КПП);
	Если СтрДлина(КПП) <> 9 Тогда
		ТекстОшибки = НСтр("ru = 'КПП должен состоять из 9 символов'");
		Возврат Ложь;
	КонецЕсли;

	Если Не СтрокаСостоитТолькоИзЦифр(Лев(КПП, 4) + Прав(КПП, 3)) Тогда
		ТекстОшибки = НСтр("ru = 'КПП имеет неверный формат'");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Контрольная цифра: сумма произведений цифр на весовые коэффициенты по модулю 11, затем по модулю 10.
//
// Параметры:
//  ИНН - Строка - ИНН (только цифры).
//  Коэффициенты - Строка - весовые коэффициенты через запятую.
//
// Возвращаемое значение:
//  Число - контрольная цифра.
//
Функция КонтрольнаяЦифра(ИНН, Коэффициенты)

	Сумма = 0;
	Веса = СтрРазделить(Коэффициенты, ",");
	Для Индекс = 0 По Веса.ВГраница() Цикл
		Сумма = Сумма + Число(Сред(ИНН, Индекс + 1, 1)) * Число(Веса[Индекс]);
	КонецЦикла;

	Возврат Сумма % 11 % 10;

КонецФункции

Функция СтрокаСостоитТолькоИзЦифр(Строка)

	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789", Сред(Строка, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти
