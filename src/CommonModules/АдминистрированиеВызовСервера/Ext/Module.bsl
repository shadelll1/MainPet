///////////////////////////////////////////////////////////////////////////////////////////////////////
// Серверные вызовы команд раздела «Администрирование».
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заполняет базу демо-данными.
//
// Возвращаемое значение:
//  Строка - текст результата для пользователя.
//
Функция ЗаполнитьДемоДанные() Экспорт

	ПроверитьПраваАдминистратора();
	Возврат ДемоДанные.Заполнить();

КонецФункции

// Выполняет автотесты бизнес-логики (в транзакциях с откатом).
//
// Возвращаемое значение:
//  ТабличныйДокумент - отчет о прогоне тестов.
//
Функция ЗапуститьСамопроверку() Экспорт

	ПроверитьПраваАдминистратора();
	Возврат Самопроверка.ОтчетОПрогоне(Самопроверка.ВыполнитьВсеТесты());

КонецФункции

// Пересчитывает себестоимость с границы пересчета (перепроводит документы).
//
// Возвращаемое значение:
//  Строка - текст результата для пользователя.
//
Функция ПересчитатьСебестоимость() Экспорт

	ПроверитьПраваАдминистратора();

	Граница = Константы.ГраницаПересчетаСебестоимости.Получить();
	Если Не ЗначениеЗаполнено(Граница) Тогда
		Возврат НСтр("ru = 'Пересчет не требуется: документов, проведенных задним числом, нет.'");
	КонецЕсли;

	Результат = ПартионныйУчетСервер.ПересчитатьСебестоимость();
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Пересчет с %1 остановлен после %2 документов.
			|%3'"), Граница, Результат.Перепроведено, Результат.Ошибка);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Себестоимость пересчитана с %1. Перепроведено документов: %2.'"),
		Граница, Результат.Перепроведено);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПраваАдминистратора()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав: команда доступна только администратору.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
