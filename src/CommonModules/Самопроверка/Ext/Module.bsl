///////////////////////////////////////////////////////////////////////////////////////////////////////
// Автотесты бизнес-логики (минимальный xUnit без внешних фреймворков).
//
// Каждый тест выполняется в отдельной транзакции, которая всегда откатывается, - тесты создают
// свои справочники и документы и не оставляют следов в базе. Поэтому запускать их можно
// и на базе с рабочими данными.
//
// Негативные тесты (ожидается отказ проведения) проверяют текст сообщения. После отказа
// транзакция считается испорченной, поэтому ожидаемый отказ - всегда последнее действие теста.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет все тесты модуля.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Тест - Строка - имя процедуры теста.
//   * Описание - Строка - что проверяет тест.
//   * Успешно - Булево - результат.
//   * Сообщение - Строка - причина падения.
//   * Длительность - Число - время выполнения, мс.
//
Функция ВыполнитьВсеТесты() Экспорт

	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("Тест");
	Результаты.Колонки.Добавить("Описание");
	Результаты.Колонки.Добавить("Успешно");
	Результаты.Колонки.Добавить("Сообщение");
	Результаты.Колонки.Добавить("Длительность");

	Для Каждого Тест Из СписокТестов() Цикл

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ОбщегоНазначения.ЗабратьСообщенияПользователю();

		// Транзакция теста намеренно никогда не фиксируется - только откатывается.
		// Имя процедуры берется из СписокТестов(), внешний ввод в Выполнить() не попадает.
		// BSLLS:PairingBrokenTransaction-off
		// BSLLS:WrongUseOfRollbackTransactionMethod-off
		// BSLLS:ExecuteExternalCodeInCommonModule-off
		НачатьТранзакцию();
		Попытка
			Выполнить("Самопроверка." + Тест.Значение + "()");
			Успешно = Истина;
			Сообщение = "";
		Исключение
			Успешно = Ложь;
			Сообщение = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Пока ТранзакцияАктивна() Цикл
			ОтменитьТранзакцию();
		КонецЦикла;
		// BSLLS:ExecuteExternalCodeInCommonModule-on
		// BSLLS:WrongUseOfRollbackTransactionMethod-on
		// BSLLS:PairingBrokenTransaction-on

		ОбщегоНазначения.ЗабратьСообщенияПользователю();

		Результат = Результаты.Добавить();
		Результат.Тест = Тест.Значение;
		Результат.Описание = Тест.Представление;
		Результат.Успешно = Успешно;
		Результат.Сообщение = Сообщение;
		Результат.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Формирует отчет о прогоне тестов.
//
// Параметры:
//  Результаты - ТаблицаЗначений - результат ВыполнитьВсеТесты().
//
// Возвращаемое значение:
//  ТабличныйДокумент - отчет: зеленые строки - пройденные тесты, красные - упавшие.
//
Функция ОтчетОПрогоне(Результаты) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Область("C1").ШиринаКолонки = 4;
	ТабличныйДокумент.Область("C2").ШиринаКолонки = 70;
	ТабличныйДокумент.Область("C3").ШиринаКолонки = 10;
	ТабличныйДокумент.Область("C4").ШиринаКолонки = 70;

	Пройдено = 0;
	Для Каждого Результат Из Результаты Цикл
		Пройдено = Пройдено + ?(Результат.Успешно, 1, 0);
	КонецЦикла;

	Ячейка = ТабличныйДокумент.Область(1, 1, 1, 4);
	Ячейка.Объединить();
	Ячейка.Текст = СтрШаблон(НСтр("ru = 'Самопроверка: пройдено %1 из %2'"), Пройдено, Результаты.Количество());
	Ячейка.Шрифт = Новый Шрифт(, 12, Истина);
	Ячейка.ЦветТекста = ?(Пройдено = Результаты.Количество(), ЦветУспеха(), ЦветОшибки());

	Ряд = 3;
	Для Каждого Результат Из Результаты Цикл
		ВывестиЯчейку(ТабличныйДокумент, Ряд, 1, ?(Результат.Успешно, "OK", "FAIL"), Результат.Успешно);
		ВывестиЯчейку(ТабличныйДокумент, Ряд, 2, Результат.Описание, Результат.Успешно);
		ВывестиЯчейку(ТабличныйДокумент, Ряд, 3, Формат(Результат.Длительность, "ЧН=0; ЧГ=0") + " мс", Результат.Успешно);
		ВывестиЯчейку(ТабличныйДокумент, Ряд, 4, Результат.Сообщение, Результат.Успешно);
		Ряд = Ряд + 1;
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Тесты - экспортные, чтобы их можно было вызвать по имени из ВыполнитьВсеТесты().

// Проверка ИНН: длина, только цифры, контрольные разряды для 10 и 12 знаков.
Процедура Тест_ПроверкаИНН() Экспорт

	ПроверитьИстину(КонтрагентыКлиентСервер.ИННСоответствуетТребованиям("7707083893", Истина),
		"корректный ИНН организации");
	ПроверитьИстину(Не КонтрагентыКлиентСервер.ИННСоответствуетТребованиям("7707083894", Истина),
		"неверная контрольная цифра ИНН организации");
	ПроверитьИстину(КонтрагентыКлиентСервер.ИННСоответствуетТребованиям("500100732259", Ложь),
		"корректный ИНН ИП");
	ПроверитьИстину(Не КонтрагентыКлиентСервер.ИННСоответствуетТребованиям("500100732258", Ложь),
		"неверная контрольная цифра ИНН ИП");
	ПроверитьИстину(Не КонтрагентыКлиентСервер.ИННСоответствуетТребованиям("77070838", Истина),
		"неверная длина");
	ПроверитьИстину(Не КонтрагентыКлиентСервер.ИННСоответствуетТребованиям("77070A3893", Истина),
		"буква в ИНН");

КонецПроцедуры

// FIFO: две партии по 100 и 120, продажа 15 шт. списывает 10 x 100 + 5 x 120 = 1600,
// во второй партии остается 5 шт. на 600.
Процедура Тест_СписаниеПартийПоFIFO() Экспорт

	К = НовыйКонтекст();
	Партия1 = Поступление(К, К.Товар, 10, 100, 3);
	Партия2 = Поступление(К, К.Товар, 10, 120, 2);

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 15, 200);
	Продажа.Записать(РежимЗаписиДокумента.Проведение);

	ПроверитьРавенство(СебестоимостьПродажи(Продажа.Ссылка), 1600, "себестоимость продажи");
	ПроверитьРавенство(ОстатокПартии(Партия1, "Количество"), 0, "остаток первой партии");
	ПроверитьРавенство(ОстатокПартии(Партия2, "Количество"), 5, "количество во второй партии");
	ПроверитьРавенство(ОстатокПартии(Партия2, "Стоимость"), 600, "стоимость второй партии");

КонецПроцедуры

// Нельзя продать больше, чем есть на складе.
Процедура Тест_КонтрольОстатковПриРеализации() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 2);

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 11, 200);
	ПроверитьОтказПроведения(Продажа, "Недостаточно");

КонецПроцедуры

// Одна номенклатура в двух строках (6 + 6 при остатке 10) не должна обходить контроль остатков.
Процедура Тест_ПовторяющаясяНоменклатураНеОбходитКонтроль() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 2);

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 6, 200);
	ДобавитьТовар(Продажа, К.Товар, 6, 200);
	ПроверитьОтказПроведения(Продажа, "Недостаточно");

КонецПроцедуры

// Резерв под заказ уменьшает свободный остаток: 10 на складе, 7 в резерве - продать 5 без заказа нельзя.
Процедура Тест_РезервУменьшаетСвободныйОстаток() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 3);
	Заказ(К, К.Товар, 7, 2);

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 5, 200);
	ПроверитьОтказПроведения(Продажа, "свободного остатка");

КонецПроцедуры

// Реализация на основании заказа снимает резерв и закрывает остаток к отгрузке;
// после этого оставшиеся 3 шт. свободны и продаются без заказа.
Процедура Тест_РеализацияПоЗаказуСнимаетРезерв() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 4);
	ЗаказСсылка = Заказ(К, К.Товар, 7, 3);

	Отгрузка = Документы.РеализацияТоваров.СоздатьДокумент();
	Отгрузка.Дата = МоментНазад(2);
	Отгрузка.Заполнить(ЗаказСсылка);
	ПроверитьРавенство(Отгрузка.Товары.Итог("Количество"), 7, "заполнение по остатку заказа");
	Отгрузка.Записать(РежимЗаписиДокумента.Проведение);

	ПроверитьРавенство(ОстатокРегистра("ТоварыВРезерве", "Количество", Новый Структура("ЗаказКлиента", ЗаказСсылка)), 0,
		"резерв по заказу после отгрузки");
	ПроверитьРавенство(ОстатокРегистра("ЗаказыКлиентов", "Количество", Новый Структура("ЗаказКлиента", ЗаказСсылка)), 0,
		"остаток к отгрузке по заказу");

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 3, 200);
	Продажа.Записать(РежимЗаписиДокумента.Проведение);

	ПроверитьРавенство(ОстатокРегистра("ТоварыНаСкладах", "Количество", Новый Структура("Номенклатура", К.Товар)), 0,
		"остаток на складе");

КонецПроцедуры

// Закрытие частично отгруженного заказа освобождает неиспользованный резерв и обнуляет остаток к отгрузке,
// не уводя регистры в минус.
Процедура Тест_ЗакрытиеЗаказаОсвобождаетРезерв() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 4);
	ЗаказСсылка = Заказ(К, К.Товар, 7, 3);

	Отгрузка = Документы.РеализацияТоваров.СоздатьДокумент();
	Отгрузка.Дата = МоментНазад(2);
	Отгрузка.Заполнить(ЗаказСсылка);
	Отгрузка.Товары[0].Количество = 3;
	Отгрузка.Записать(РежимЗаписиДокумента.Проведение);

	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);

	Отбор = Новый Структура("ЗаказКлиента", ЗаказСсылка);
	ПроверитьРавенство(ОстатокРегистра("ТоварыВРезерве", "Количество", Отбор), 0, "резерв закрытого заказа");
	ПроверитьРавенство(ОстатокРегистра("ЗаказыКлиентов", "Количество", Отбор), 0, "остаток к отгрузке закрытого заказа");

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 7, 200);
	Продажа.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// Реализацию по уже закрытому заказу можно перепровести (это делает пересчет себестоимости),
// а новую отгрузку по закрытому заказу - нельзя.
Процедура Тест_ПерепроведениеОтгрузкиПоЗакрытомуЗаказу() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 4);
	ЗаказСсылка = Заказ(К, К.Товар, 7, 3);

	Отгрузка = Документы.РеализацияТоваров.СоздатьДокумент();
	Отгрузка.Дата = МоментНазад(2);
	Отгрузка.Заполнить(ЗаказСсылка);
	Отгрузка.Товары[0].Количество = 3;
	Отгрузка.Записать(РежимЗаписиДокумента.Проведение);

	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);

	Отгрузка.Записать(РежимЗаписиДокумента.Проведение);

	НоваяОтгрузка = Документы.РеализацияТоваров.СоздатьДокумент();
	НоваяОтгрузка.Дата = МоментНазад(1);
	НоваяОтгрузка.Контрагент = К.Клиент;
	НоваяОтгрузка.Склад = К.Склад;
	НоваяОтгрузка.ЗаказКлиента = ЗаказСсылка;
	ДобавитьТовар(НоваяОтгрузка, К.Товар, 1, 200);
	ПроверитьОтказПроведения(НоваяОтгрузка, "К отгрузке");

КонецПроцедуры

// По заказу нельзя отгрузить больше, чем заказано.
Процедура Тест_ОтгрузкаСверхЗаказаЗапрещена() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 4);
	ЗаказСсылка = Заказ(К, К.Товар, 2, 3);

	Отгрузка = Документы.РеализацияТоваров.СоздатьДокумент();
	Отгрузка.Дата = МоментНазад(2);
	Отгрузка.Заполнить(ЗаказСсылка);
	Отгрузка.Товары[0].Количество = 3;
	ПроверитьОтказПроведения(Отгрузка, "сверх заказанного");

КонецПроцедуры

// Перемещение переносит партию на другой склад вместе с ее себестоимостью.
Процедура Тест_ПеремещениеПереноситПартию() Экспорт

	К = НовыйКонтекст();
	Партия = Поступление(К, К.Товар, 10, 100, 2);

	Перемещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
	Перемещение.Дата = МоментНазад(1);
	Перемещение.СкладОтправитель = К.Склад;
	Перемещение.СкладПолучатель = К.Склад2;
	НоваяСтрока = Перемещение.Товары.Добавить();
	НоваяСтрока.Номенклатура = К.Товар;
	НоваяСтрока.Количество = 4;
	Перемещение.Записать(РежимЗаписиДокумента.Проведение);

	Отбор = Новый Структура("Партия, Склад", Партия, К.Склад2);
	ПроверитьРавенство(ОстатокРегистра("ПартииТоваров", "Количество", Отбор), 4, "количество партии на складе-получателе");
	ПроверитьРавенство(ОстатокРегистра("ПартииТоваров", "Стоимость", Отбор), 400, "стоимость партии на складе-получателе");

КонецПроцедуры

// Нельзя уменьшить поступление, если товар из него уже продан.
Процедура Тест_УменьшениеПроданногоПоступленияЗапрещено() Экспорт

	К = НовыйКонтекст();
	Партия = Поступление(К, К.Товар, 10, 100, 2);

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 8, 200);
	Продажа.Записать(РежимЗаписиДокумента.Проведение);

	ПоступлениеОбъект = Партия.ПолучитьОбъект();
	ПоступлениеОбъект.Товары[0].Количество = 5;
	ПроверитьОтказПроведения(ПоступлениеОбъект, "уже списан");

КонецПроцедуры

// Нельзя отменить проведение поступления, товар из которого уже продан.
Процедура Тест_ОтменаПроведенияПроданногоПоступленияЗапрещена() Экспорт

	К = НовыйКонтекст();
	Партия = Поступление(К, К.Товар, 10, 100, 2);

	Продажа = НоваяРеализация(К, 1);
	ДобавитьТовар(Продажа, К.Товар, 8, 200);
	Продажа.Записать(РежимЗаписиДокумента.Проведение);

	ПроверитьОтказЗаписи(Партия.ПолучитьОбъект(), РежимЗаписиДокумента.ОтменаПроведения, "Недостаточно");

КонецПроцедуры

// Поступление задним числом раньше уже проданной партии. До пересчета продажа списана
// по партии 100 (5 x 100 = 500), и отмечена граница пересчета. После пересчета FIFO берет
// более раннюю партию по 50: 5 x 50 = 250, граница сброшена.
Процедура Тест_ПересчетСебестоимостиПослеПроведенияЗаднимЧислом() Экспорт

	К = НовыйКонтекст();
	Поступление(К, К.Товар, 10, 100, 5);

	Продажа = НоваяРеализация(К, 3);
	ДобавитьТовар(Продажа, К.Товар, 5, 200);
	Продажа.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавенство(СебестоимостьПродажи(Продажа.Ссылка), 500, "себестоимость до проведения задним числом");
	ПроверитьИстину(Не ЗначениеЗаполнено(Константы.ГраницаПересчетаСебестоимости.Получить()),
		"граница пересчета пуста, пока документы проводятся по порядку");

	РанняяПартия = Поступление(К, К.Товар, 10, 50, 6);
	ПроверитьРавенство(Константы.ГраницаПересчетаСебестоимости.Получить(),
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РанняяПартия, "Дата"), "граница пересчета");

	Результат = ПартионныйУчетСервер.ПересчитатьСебестоимость();
	ПроверитьРавенство(Результат.Ошибка, "", "ошибка пересчета");
	ПроверитьРавенство(СебестоимостьПродажи(Продажа.Ссылка), 250, "себестоимость после пересчета");
	ПроверитьИстину(Не ЗначениеЗаполнено(Константы.ГраницаПересчетаСебестоимости.Получить()),
		"граница пересчета сброшена");

КонецПроцедуры

// Ответственный в документе заполняется текущим пользователем (на нем построен RLS менеджера).
Процедура Тест_ОтветственныйЗаполняетсяТекущимПользователем() Экспорт

	К = НовыйКонтекст();
	Партия = Поступление(К, К.Товар, 1, 100, 1);

	Ответственный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "Ответственный");
	ПроверитьИстину(ЗначениеЗаполнено(Ответственный), "ответственный заполнен");
	ПроверитьРавенство(Ответственный, ПараметрыСеанса.ТекущийПользователь, "ответственный - текущий пользователь");

КонецПроцедуры

// Документ с датой в закрытом периоде записать нельзя.
Процедура Тест_ДатаЗапретаИзменения() Экспорт

	К = НовыйКонтекст();
	Константы.ДатаЗапретаИзменения.Установить(НачалоДня(ТекущаяДатаСеанса()) - 86400);

	ДокументОбъект = Документы.ПоступлениеТоваров.СоздатьДокумент();
	ДокументОбъект.Дата = НачалоДня(ТекущаяДатаСеанса()) - 2 * 86400;
	ДокументОбъект.Контрагент = К.Поставщик;
	ДокументОбъект.Склад = К.Склад;
	ДобавитьТовар(ДокументОбъект, К.Товар, 1, 100);
