#Область Данные

// Создает изолированный набор справочников для теста.
//
// Возвращаемое значение:
//  Структура - Склад, Склад2, Поставщик, Клиент, Товар.
//
Функция НовыйКонтекст()

	// Тест не должен зависеть от настроек базы.
	Константы.ДатаЗапретаИзменения.Установить(Дата(1, 1, 1));
	Константы.ГраницаПересчетаСебестоимости.Установить(Дата(1, 1, 1));

	Суффикс = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8);

	Единица = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
	Единица.Наименование = "шт";
	Единица.Записать();

	Контекст = Новый Структура;
	Контекст.Вставить("Склад", НовыйСклад("Тест склад 1 " + Суффикс));
	Контекст.Вставить("Склад2", НовыйСклад("Тест склад 2 " + Суффикс));
	Контекст.Вставить("Поставщик", НовыйКонтрагент("Тест поставщик " + Суффикс));
	Контекст.Вставить("Клиент", НовыйКонтрагент("Тест клиент " + Суффикс));

	Товар = Справочники.Номенклатура.СоздатьЭлемент();
	Товар.Наименование = "Тест товар " + Суффикс;
	Товар.Артикул = "T-" + Суффикс;
	Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	Товар.ЕдиницаИзмерения = Единица.Ссылка;
	Товар.Записать();
	Контекст.Вставить("Товар", Товар.Ссылка);

	Возврат Контекст;

КонецФункции

Функция НовыйСклад(Наименование)

	Объект = Справочники.Склады.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НовыйКонтрагент(Наименование)

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

// Создает и проводит поступление.
//
// Параметры:
//  К - Структура - контекст теста.
//  Товар - СправочникСсылка.Номенклатура - товар.
//  Количество - Число - количество.
//  Цена - Число - закупочная цена.
//  ЧасовНазад - Число - дата документа относительно текущего момента.
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваров - проведенное поступление (партия).
//
Функция Поступление(К, Товар, Количество, Цена, ЧасовНазад)

	ДокументОбъект = Документы.ПоступлениеТоваров.СоздатьДокумент();
	ДокументОбъект.Дата = МоментНазад(ЧасовНазад);
	ДокументОбъект.Контрагент = К.Поставщик;
	ДокументОбъект.Склад = К.Склад;
	ДобавитьТовар(ДокументОбъект, Товар, Количество, Цена);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокументОбъект.Ссылка;

КонецФункции

// Создает и проводит заказ «К отгрузке» (с резервом).
//
// Параметры:
//  К - Структура - контекст теста.
//  Товар - СправочникСсылка.Номенклатура - товар.
//  Количество - Число - количество.
//  ЧасовНазад - Число - дата документа относительно текущего момента.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказКлиента - проведенный заказ.
//
Функция Заказ(К, Товар, Количество, ЧасовНазад)

	ДокументОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
	ДокументОбъект.Дата = МоментНазад(ЧасовНазад);
	ДокументОбъект.Контрагент = К.Клиент;
	ДокументОбъект.Склад = К.Склад;
	ДокументОбъект.ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса()) + 86400;
	ДокументОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.КОтгрузке;
	ДобавитьТовар(ДокументОбъект, Товар, Количество, 200);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокументОбъект.Ссылка;

КонецФункции

Функция НоваяРеализация(К, ЧасовНазад)

	ДокументОбъект = Документы.РеализацияТоваров.СоздатьДокумент();
	ДокументОбъект.Дата = МоментНазад(ЧасовНазад);
	ДокументОбъект.Контрагент = К.Клиент;
	ДокументОбъект.Склад = К.Склад;
	Возврат ДокументОбъект;

КонецФункции

Процедура ДобавитьТовар(ДокументОбъект, Товар, Количество, Цена)

	НоваяСтрока = ДокументОбъект.Товары.Добавить();
	НоваяСтрока.Номенклатура = Товар;
	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Цена = Цена;

КонецПроцедуры

Функция МоментНазад(ЧасовНазад)

	Возврат ТекущаяДатаСеанса() - ЧасовНазад * 3600;

КонецФункции

// Текущий остаток ресурса регистра накопления с отбором по измерениям.
//
// Параметры:
//  ИмяРегистра - Строка - имя регистра накопления.
//  ИмяРесурса - Строка - имя ресурса.
//  Отбор - Структура - ключ: имя измерения, значение: значение отбора.
//
// Возвращаемое значение:
//  Число - остаток.
//
Функция ОстатокРегистра(ИмяРегистра, ИмяРесурса, Отбор)

	Условия = Новый Массив;
	Запрос = Новый Запрос;
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Условия.Добавить(СтрШаблон("%1 = &%1", ЭлементОтбора.Ключ));
		Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
	КонецЦикла;

	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.%2Остаток), 0) КАК Значение
		|ИЗ
		|	РегистрНакопления.%1.Остатки(, %3) КАК Остатки",
		ИмяРегистра, ИмяРесурса, СтрСоединить(Условия, " И "));

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Значение;

КонецФункции

Функция ОстатокПартии(Партия, ИмяРесурса)

	Возврат ОстатокРегистра("ПартииТоваров", ИмяРесурса, Новый Структура("Партия", Партия));

КонецФункции

Функция СебестоимостьПродажи(Регистратор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Продажи.Себестоимость), 0) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Регистратор = &Регистратор";

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Себестоимость;

КонецФункции

#КонецОбласти

#Область Утверждения

Процедура ПроверитьРавенство(Фактическое, Ожидаемое, Описание)

	Если Фактическое <> Ожидаемое Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = '%1: ожидалось %2, получено %3'"), Описание, Ожидаемое, Фактическое);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИстину(Условие, Описание)

	Если Не Условие Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не выполнено условие: %1'"), Описание);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОтказПроведения(ДокументОбъект, ОжидаемыйФрагмент)

	ПроверитьОтказЗаписи(ДокументОбъект, РежимЗаписиДокумента.Проведение, ОжидаемыйФрагмент);

КонецПроцедуры

// Ожидает, что запись документа завершится отказом с сообщением, содержащим фрагмент текста.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - записываемый документ.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  ОжидаемыйФрагмент - Строка - фрагмент ожидаемого сообщения.
//
Процедура ПроверитьОтказЗаписи(ДокументОбъект, РежимЗаписи, ОжидаемыйФрагмент)

	ОбщегоНазначения.ЗабратьСообщенияПользователю();
	Попытка
		ДокументОбъект.Записать(РежимЗаписи);
	Исключение
		Сообщения = ОбщегоНазначения.ЗабратьСообщенияПользователю();
		Если СтрНайти(Сообщения, ОжидаемыйФрагмент) = 0 Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Запись отклонена, но без сообщения «%1». Сообщения: %2. Ошибка: %3'"),
				ОжидаемыйФрагмент, Сообщения, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Возврат;
	КонецПопытки;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Ожидался отказ записи с сообщением «%1», но документ записан'"),
		ОжидаемыйФрагмент);

КонецПроцедуры

#КонецОбласти

#Область Отчет

Процедура ВывестиЯчейку(ТабличныйДокумент, Ряд, Колонка, Текст, Успешно)

	Ячейка = ТабличныйДокумент.Область(Ряд, Колонка, Ряд, Колонка);
	Ячейка.Текст = Текст;
	Ячейка.ЦветТекста = ?(Успешно, ЦветУспеха(), ЦветОшибки());
	Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

КонецПроцедуры

Функция ЦветУспеха()

	Возврат Новый Цвет(0, 128, 0);

КонецФункции

Функция ЦветОшибки()

	Возврат Новый Цвет(192, 0, 0);

КонецФункции

