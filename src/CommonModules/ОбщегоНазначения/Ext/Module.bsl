#Область ПрограммныйИнтерфейс

// Возвращает значения реквизитов объекта, прочитанные из информационной базы запросом
// (без получения объекта целиком).
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - объект, реквизиты которого нужно прочитать.
//  Реквизиты - Строка - имена реквизитов через запятую, например "Статус, Склад".
//
// Возвращаемое значение:
//  Структура - ключи совпадают с именами реквизитов; если объект не найден - значения Неопределено.
//
Функция ЗначенияРеквизитовОбъекта(Ссылка, Знач Реквизиты) Экспорт

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	ПоляЗапроса = Новый Массив;
	Для Каждого КлючИЗначение Из Результат Цикл
		ПоляЗапроса.Добавить(СтрШаблон("Таблица.%1 КАК %1", КлючИЗначение.Ключ));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	%1
		|ИЗ
		|	%2 КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка",
		СтрСоединить(ПоляЗапроса, "," + Символы.ПС + Символы.Таб),
		Ссылка.Метаданные().ПолноеИмя());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает значение одного реквизита объекта, прочитанное из информационной базы.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - объект.
//  ИмяРеквизита - Строка - имя реквизита.
//
// Возвращаемое значение:
//  Произвольный - значение реквизита или Неопределено, если объект не найден.
//
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита) Экспорт

	Возврат ЗначенияРеквизитовОбъекта(Ссылка, ИмяРеквизита)[ИмяРеквизита];

КонецФункции

// Проверяет, что объект с указанной ссылкой существует в информационной базе.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - проверяемая ссылка.
//
// Возвращаемое значение:
//  Булево - Истина, если запись есть в таблице объекта.
//
Функция СсылкаСуществует(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Существует
		|ИЗ
		|	%1 КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка", Ссылка.Метаданные().ПолноеИмя());

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Возвращает описание типа Число с заданной разрядностью.
//
// Параметры:
//  Разрядность - Число - общее количество разрядов.
//  РазрядностьДробнойЧасти - Число - количество знаков после запятой.
//
// Возвращаемое значение:
//  ОписаниеТипов - описание типа Число.
//
Функция ОписаниеТипаЧисло(Разрядность, РазрядностьДробнойЧасти = 0) Экспорт

	Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(Разрядность, РазрядностьДробнойЧасти));

КонецФункции

// Возвращает текст всех накопленных сообщений пользователю и очищает их очередь.
// Используется там, где сообщения нужно вернуть вызывающей стороне (REST API, автотесты),
// а не показать пользователю.
//
// Возвращаемое значение:
//  Строка - тексты сообщений, разделенные переводом строки.
//
Функция ЗабратьСообщенияПользователю() Экспорт

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти
