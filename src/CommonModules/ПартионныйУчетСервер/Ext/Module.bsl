///////////////////////////////////////////////////////////////////////////////////////////////////////
// Партионный учет себестоимости по методу FIFO.
//
// Партия - документ ПоступлениеТоваров. Списание идет с самой ранней партии (по моменту времени
// документа поступления) на конкретном складе. Остатки партий читаются на момент проводимого
// документа, не включая его самого, - поэтому расчет корректен и при перепроведении.
//
// Вызывающий код обязан заранее установить исключительную управляемую блокировку
// на регистр ПартииТоваров по ключам (Номенклатура, Склад), иначе параллельные документы
// могут списать одну и ту же партию.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Рассчитывает списание партий по методу FIFO.
//
// Параметры:
//  ТаблицаСписания - ТаблицаЗначений - что нужно списать; колонки:
//   * Номенклатура - СправочникСсылка.Номенклатура
//   * Склад - СправочникСсылка.Склады
//   * Количество - Число
//  МоментВремени - МоментВремени - момент проводимого документа; остатки партий берутся до него.
//
// Возвращаемое значение:
//  Структура:
//   * Списание - ТаблицаЗначений - Номенклатура, Склад, Партия, Количество, Стоимость.
//   * Нехватка - ТаблицаЗначений - Номенклатура, Склад, Количество: сколько не покрыто партиями.
//
Функция РассчитатьСписаниеFIFO(ТаблицаСписания, МоментВремени) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Списание", НоваяТаблицаСписанияПартий());
	Результат.Вставить("Нехватка", НоваяТаблицаНехватки());

	Если ТаблицаСписания.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Партии = ОстаткиПартийПоFIFO(ТаблицаСписания, МоментВремени);

	ОтборПартий = Новый Структура("Номенклатура, Склад");
	Для Каждого СтрокаСписания Из ТаблицаСписания Цикл

		ОсталосьСписать = СтрокаСписания.Количество;
		ЗаполнитьЗначенияСвойств(ОтборПартий, СтрокаСписания);

		Для Каждого Партия Из Партии.НайтиСтроки(ОтборПартий) Цикл

			Если ОсталосьСписать <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если Партия.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;

			КоличествоСписания = Мин(ОсталосьСписать, Партия.Количество);

			// Партия списывается целиком - забираем всю остаточную стоимость, чтобы не оставить
			// копеечный "хвост" от округления. Частично - пропорционально количеству.
			Если КоличествоСписания = Партия.Количество Тогда
				СтоимостьСписания = Партия.Стоимость;
			Иначе
				СтоимостьСписания = Окр(Партия.Стоимость * КоличествоСписания / Партия.Количество, 2);
			КонецЕсли;

			СтрокаРезультата = Результат.Списание.Добавить();
			СтрокаРезультата.Номенклатура = СтрокаСписания.Номенклатура;
			СтрокаРезультата.Склад = СтрокаСписания.Склад;
			СтрокаРезультата.Партия = Партия.Партия;
			СтрокаРезультата.Количество = КоличествоСписания;
			СтрокаРезультата.Стоимость = СтоимостьСписания;

			// Уменьшаем остаток партии: если в таблице списания ключ повторится,
			// повторно списать ту же партию не получится.
			Партия.Количество = Партия.Количество - КоличествоСписания;
			Партия.Стоимость = Партия.Стоимость - СтоимостьСписания;
			ОсталосьСписать = ОсталосьСписать - КоличествоСписания;

		КонецЦикла;

		Если ОсталосьСписать > 0 Тогда
			СтрокаНехватки = Результат.Нехватка.Добавить();
			СтрокаНехватки.Номенклатура = СтрокаСписания.Номенклатура;
			СтрокаНехватки.Склад = СтрокаСписания.Склад;
			СтрокаНехватки.Количество = ОсталосьСписать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сообщает о товарах, которые не удалось списать по партиям.
//
// Параметры:
//  Нехватка - ТаблицаЗначений - таблица Нехватка из результата РассчитатьСписаниеFIFO.
//  Документ - ДокументСсылка - документ, к которому привязываются сообщения.
//  Отказ - Булево - устанавливается в Истина, если нехватка есть.
//
Процедура СообщитьОНехваткеПартий(Нехватка, Документ, Отказ) Экспорт

	Для Каждого СтрокаНехватки Из Нехватка Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Недостаточно товара «%1» на складе «%2» на момент документа: не хватает %3'"),
				СтрокаНехватки.Номенклатура, СтрокаНехватки.Склад,
				ОбщегоНазначенияКлиентСервер.ПредставлениеКоличества(СтрокаНехватки.Количество)),
			Документ, , , Отказ);
	КонецЦикла;

КонецПроцедуры

// Создает пустую таблицу списания партий с типизированными колонками
// (типы нужны, чтобы таблицу можно было передать в запрос параметром).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Склад, Партия, Количество, Стоимость.
//
Функция НоваяТаблицаСписанияПартий() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Таблица.Колонки.Добавить("Партия", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваров"));
	Таблица.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Таблица.Колонки.Добавить("Стоимость", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));

	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область ПересчетСебестоимости

// Проведение задним числом (или отмена проведения, изменение даты) документа, влияющего на партии,
// делает неверной себестоимость более поздних документов: FIFO списывал бы другие партии.
// Вместо перепроведения «хвоста» прямо в транзакции пользователя запоминаем границу -
// самый ранний момент, с которого нужен пересчет, - а сам пересчет выполняет регламентное
// задание или команда администратора (аналог восстановления последовательности).

// Запоминает дату документа, с которой он записан в базе, - до записи новой версии.
// Вызывается из ПередЗаписью документов, влияющих на партии.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - записываемый документ.
//
Процедура ЗапомнитьДатуДоИзменения(ДокументОбъект) Экспорт

	Если Не ДокументОбъект.ЭтоНовый() Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("ДатаДоИзменения",
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Ссылка, "Дата"));
	КонецЕсли;

КонецПроцедуры

// Сдвигает границу пересчета себестоимости на дату документа, если после нее по той же
// номенклатуре уже есть движения партий других документов.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - проводимый или распроводимый документ.
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - номенклатура старых и новых движений.
//
Процедура ЗарегистрироватьИзменениеПартий(ДокументОбъект, Номенклатура) Экспорт

	// Документы, которые перепроводит сам пересчет, границу не двигают.
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ПересчетСебестоимости")
		Или Номенклатура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДатаИзменения = ДокументОбъект.Дата;
	ДатаДоИзменения = Неопределено;
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ДатаДоИзменения", ДатаДоИзменения)
		И ЗначениеЗаполнено(ДатаДоИзменения) Тогда
		ДатаИзменения = Мин(ДатаИзменения, ДатаДоИзменения);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаИзменения);
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьБолееПоздние
	|ИЗ
	|	РегистрНакопления.ПартииТоваров КАК ПартииТоваров
	|ГДЕ
	|	ПартииТоваров.Период > &Дата
	|	И ПартииТоваров.Регистратор <> &Регистратор
	|	И ПартииТоваров.Номенклатура В (&Номенклатура)";

	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	ЗаблокироватьГраницуПересчета();
	ТекущаяГраница = Константы.ГраницаПересчетаСебестоимости.Получить();
	Если Не ЗначениеЗаполнено(ТекущаяГраница) Или ДатаИзменения < ТекущаяГраница Тогда
		Константы.ГраницаПересчетаСебестоимости.Установить(ДатаИзменения);
	КонецЕсли;

КонецПроцедуры

// Перепроводит в хронологическом порядке документы, влияющие на партии, начиная с границы
// пересчета. Документы закрытого периода не перепроводятся: их себестоимость зафиксирована.
// Если документ провести не удалось, граница переносится на него, и следующий запуск
// продолжит с этого места.
//
// Возвращаемое значение:
//  Структура:
//   * Перепроведено - Число - сколько документов перепроведено.
//   * Ошибка - Строка - описание ошибки, если пересчет остановлен; пустая строка при успехе.
//
Функция ПересчитатьСебестоимость() Экспорт

	Результат = Новый Структура("Перепроведено, Ошибка", 0, "");

	Граница = Константы.ГраницаПересчетаСебестоимости.Получить();
	Если Не ЗначениеЗаполнено(Граница) Тогда
		Возврат Результат;
	КонецЕсли;

	ДатаЗапрета = ДатыЗапретаИзменения.ДатаЗапретаИзменения();
	НачалоПересчета = Граница;
	Если ЗначениеЗаполнено(ДатаЗапрета) Тогда
		НачалоПересчета = Макс(Граница, КонецДня(ДатаЗапрета) + 1);
	КонецЕсли;

	Выборка = ДокументыДляПересчета(НачалоПересчета).Выбрать();
	Пока Выборка.Следующий() Цикл

		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПересчетСебестоимости", Истина);
		ОбщегоНазначения.ЗабратьСообщенияПользователю();
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Результат.Ошибка = СтрШаблон(НСтр("ru = 'Не удалось перепровести %1: %2 %3'"), Выборка.Ссылка,
				ОбщегоНазначения.ЗабратьСообщенияПользователю(),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ИмяСобытияПересчета(), УровеньЖурналаРегистрации.Ошибка,
				Выборка.Ссылка.Метаданные(), Выборка.Ссылка, Результат.Ошибка);
			ЗаменитьГраницуПересчета(Граница, Выборка.Дата);
			Возврат Результат;
		КонецПопытки;

		Результат.Перепроведено = Результат.Перепроведено + 1;

	КонецЦикла;

	// Сбрасываем границу, только если ее не сдвинули, пока шел пересчет.
	ЗаменитьГраницуПересчета(Граница, Дата(1, 1, 1));

	ЗаписьЖурналаРегистрации(ИмяСобытияПересчета(), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru = 'Пересчет с %1 завершен, перепроведено документов: %2'"),
			Граница, Результат.Перепроведено));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Документы, влияющие на партии, с даты начала пересчета - в порядке проведения.
//
// Параметры:
//  НачалоПересчета - Дата - с какой даты перепроводить.
//
// Возвращаемое значение:
//  РезультатЗапроса - колонки Ссылка, Дата, МоментВремени.
//
Функция ДокументыДляПересчета(НачалоПересчета)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПересчета", НачалоПересчета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Дата КАК Дата,
	|	Поступление.МоментВремени КАК МоментВремени
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК Поступление
	|ГДЕ
	|	Поступление.Проведен
	|	И Поступление.Дата >= &НачалоПересчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Перемещение.Ссылка,
	|	Перемещение.Дата,
	|	Перемещение.МоментВремени
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК Перемещение
	|ГДЕ
	|	Перемещение.Проведен
	|	И Перемещение.Дата >= &НачалоПересчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Реализация.Ссылка,
	|	Реализация.Дата,
	|	Реализация.МоментВремени
	|ИЗ
	|	Документ.РеализацияТоваров КАК Реализация
	|ГДЕ
	|	Реализация.Проведен
	|	И Реализация.Дата >= &НачалоПересчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";

	Возврат Запрос.Выполнить();

КонецФункции

// Заменяет границу пересчета, если она все еще равна ожидаемой (сравнение с заменой под блокировкой).
//
// Параметры:
//  ОжидаемаяГраница - Дата - значение, с которым начинался пересчет.
//  НоваяГраница - Дата - новое значение (пустая дата - пересчет не нужен).
//
Процедура ЗаменитьГраницуПересчета(ОжидаемаяГраница, НоваяГраница)

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГраницуПересчета();
		Если Константы.ГраницаПересчетаСебестоимости.Получить() = ОжидаемаяГраница Тогда
			Константы.ГраницаПересчетаСебестоимости.Установить(НоваяГраница);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗаблокироватьГраницуПересчета()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Константа.ГраницаПересчетаСебестоимости");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ИмяСобытияПересчета()

	Возврат НСтр("ru = 'Партионный учет.Пересчет себестоимости'", "ru");

КонецФункции

// Остатки партий по ключам списания, упорядоченные от самой ранней партии к самой поздней.
//
// Параметры:
//  ТаблицаСписания - ТаблицаЗначений - колонки Номенклатура, Склад (типизированные).
//  МоментВремени - МоментВремени - остатки берутся до этого момента, не включая его.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Склад, Партия, Количество, Стоимость.
//
Функция ОстаткиПартийПоFIFO(ТаблицаСписания, МоментВремени)

	Ключи = ТаблицаСписания.Скопировать(, "Номенклатура, Склад");
	Ключи.Свернуть("Номенклатура, Склад");

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени, ВидГраницы.Исключая));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Склад КАК Склад
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПартииОстатки.Номенклатура КАК Номенклатура,
	|	ПартииОстатки.Склад КАК Склад,
	|	ПартииОстатки.Партия КАК Партия,
	|	ПартииОстатки.КоличествоОстаток КАК Количество,
	|	ПартииОстатки.СтоимостьОстаток КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(
	|			&Граница,
	|			(Номенклатура, Склад) В
	|				(ВЫБРАТЬ
	|					ВТКлючи.Номенклатура КАК Номенклатура,
	|					ВТКлючи.Склад КАК Склад
	|				ИЗ
	|					ВТКлючи КАК ВТКлючи)) КАК ПартииОстатки
	|ГДЕ
	|	ПартииОстатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПартииОстатки.Партия.МоментВремени";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

