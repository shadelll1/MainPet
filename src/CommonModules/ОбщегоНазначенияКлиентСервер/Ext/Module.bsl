///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общие процедуры и функции, доступные и на клиенте, и на сервере.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выводит сообщение пользователю. Если указано поле - сообщение привязывается к нему,
// и при открытой форме объекта курсор переходит к ошибочному реквизиту.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения.
//  КлючДанных - ЛюбаяСсылка, Неопределено - объект, к которому относится сообщение.
//  Поле - Строка - имя реквизита, например "Контрагент" или "Товары[0].Количество".
//  ПутьКДанным - Строка - путь к данным формы, обычно "Объект".
//  Отказ - Булево - выходной параметр: устанавливается в Истина.
//
Процедура СообщитьПользователю(Знач ТекстСообщения, Знач КлючДанных = Неопределено, Знач Поле = "",
	Знач ПутьКДанным = "", Отказ = Ложь) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = Поле;

	Если ЗначениеЗаполнено(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;

	Если ЗначениеЗаполнено(КлючДанных) Тогда
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;

	Сообщение.Сообщить();

	Отказ = Истина;

КонецПроцедуры

// Формирует путь к реквизиту строки табличной части для привязки сообщения.
//
// Параметры:
//  ИмяТабличнойЧасти - Строка - например "Товары".
//  НомерСтроки - Число - номер строки (с единицы, как в НомерСтроки).
//  ИмяРеквизита - Строка - например "Количество".
//
// Возвращаемое значение:
//  Строка - путь вида "Товары[0].Количество".
//
Функция ПутьКРеквизитуСтроки(ИмяТабличнойЧасти, НомерСтроки, ИмяРеквизита) Экспорт

	Возврат СтрШаблон("%1[%2].%3", ИмяТабличнойЧасти, Формат(НомерСтроки - 1, "ЧН=0; ЧГ=0"), ИмяРеквизита);

КонецФункции

// Форматирует количество для вывода в сообщениях.
//
// Параметры:
//  Количество - Число - значение.
//
// Возвращаемое значение:
//  Строка - число без группировки разрядов, до трех знаков после запятой.
//
Функция ПредставлениеКоличества(Количество) Экспорт

	Возврат Формат(Количество, "ЧДЦ=3; ЧН=0; ЧГ=0");

КонецФункции

// Форматирует денежную сумму для вывода.
//
// Параметры:
//  Сумма - Число - значение.
//
// Возвращаемое значение:
//  Строка - число с двумя знаками после запятой и группировкой разрядов.
//
Функция ПредставлениеСуммы(Сумма) Экспорт

	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0,00");

КонецФункции

#КонецОбласти
