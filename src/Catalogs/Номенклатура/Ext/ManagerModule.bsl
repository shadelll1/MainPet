#Область ПрограммныйИнтерфейс

// Отбирает из списка позиции с типом «Услуга».
//
// Параметры:
//  СписокНоменклатуры - Массив из СправочникСсылка.Номенклатура - проверяемые позиции.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - услуги из переданного списка.
//
Функция Услуги(СписокНоменклатуры) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&СписокНоменклатуры)
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Проверяет, используется ли артикул другой позицией номенклатуры.
//
// Параметры:
//  Артикул - Строка - проверяемый артикул.
//  ИсключаемаяСсылка - СправочникСсылка.Номенклатура - текущая позиция (не считается дублем).
//
// Возвращаемое значение:
//  Булево - Истина, если артикул занят.
//
Функция АртикулЗанят(Артикул, ИсключаемаяСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	Запрос.УстановитьПараметр("Ссылка", ИсключаемаяСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Занят
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И Номенклатура.Ссылка <> &Ссылка
	|	И НЕ Номенклатура.ЭтоГруппа";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Находит позицию номенклатуры по артикулу.
//
// Параметры:
//  Артикул - Строка - артикул.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - найденная позиция или пустая ссылка.
//
Функция НайтиПоАртикулу(Артикул) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Номенклатура.ПустаяСсылка());

КонецФункции

#КонецОбласти

#КонецЕсли
