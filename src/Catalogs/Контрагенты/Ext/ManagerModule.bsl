#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Проверяет, есть ли в справочнике другой контрагент с такой же парой ИНН + КПП.
// (У обособленных подразделений одной организации ИНН совпадает, а КПП различается.)
//
// Параметры:
//  ИНН - Строка - ИНН.
//  КПП - Строка - КПП (может быть пустым).
//  ИсключаемаяСсылка - СправочникСсылка.Контрагенты - текущий контрагент.
//
// Возвращаемое значение:
//  Булево - Истина, если найден дубль.
//
Функция ИННЗанят(ИНН, КПП, ИсключаемаяСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("КПП", СокрЛП(КПП));
	Запрос.УстановитьПараметр("Ссылка", ИсключаемаяСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Занят
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|	И Контрагенты.Ссылка <> &Ссылка
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Находит контрагента по ИНН (первого не помеченного на удаление).
//
// Параметры:
//  ИНН - Строка - ИНН.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - найденный контрагент или пустая ссылка.
//
Функция НайтиПоИНН(ИНН) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Код";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Контрагенты.ПустаяСсылка());

КонецФункции

#КонецОбласти

#КонецЕсли
