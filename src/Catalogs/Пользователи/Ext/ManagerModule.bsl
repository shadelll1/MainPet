#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает элемент справочника, связанный с текущим пользователем информационной базы.
// При первом входе пользователя элемент создается. Если в базе нет ни одного пользователя ИБ
// (работа без авторизации), используется служебный элемент «Администратор».
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - текущий пользователь.
//
Функция ТекущийПользователь() Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПустаяСтрока(ПользовательИБ.Имя) Тогда
		Идентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		Наименование = НСтр("ru = 'Администратор'");
	Иначе
		Идентификатор = ПользовательИБ.УникальныйИдентификатор;
		Наименование = ?(ПустаяСтрока(ПользовательИБ.ПолноеИмя), ПользовательИБ.Имя, ПользовательИБ.ПолноеИмя);
	КонецЕсли;

	Пользователь = НайтиПоИдентификаторуИБ(Идентификатор);
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Пользователь;
	КонецЕсли;

	// Первый вход: создаем элемент под блокировкой, чтобы два одновременных входа
	// одного пользователя не создали дубль.
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Пользователи");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Пользователь = НайтиПоИдентификаторуИБ(Идентификатор);
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			Объект = Справочники.Пользователи.СоздатьЭлемент();
			Объект.Наименование = Наименование;
			Объект.ИдентификаторПользователяИБ = Идентификатор;
			Объект.Записать();
			Пользователь = Объект.Ссылка;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Пользователь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Находит пользователя по идентификатору пользователя ИБ.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор пользователя ИБ.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - найденный пользователь или пустая ссылка.
//
Функция НайтиПоИдентификаторуИБ(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Идентификатор";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Пользователи.ПустаяСсылка());

КонецФункции

#КонецОбласти

#КонецЕсли
