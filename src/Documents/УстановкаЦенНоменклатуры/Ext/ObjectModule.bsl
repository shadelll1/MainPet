#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Одна номенклатура в документе - одна запись регистра на дату документа.
	// Дубль строки дал бы конфликт ключей записи регистра сведений.
	ВстречалисьРанее = Новый Соответствие;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		НомерПервойСтроки = ВстречалисьРанее.Получить(СтрокаТоваров.Номенклатура);
		Если НомерПервойСтроки = Неопределено Тогда
			ВстречалисьРанее.Вставить(СтрокаТоваров.Номенклатура, СтрокаТоваров.НомерСтроки);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Строка %1: цена на «%2» уже указана в строке %3'"),
					СтрокаТоваров.НомерСтроки, СтрокаТоваров.Номенклатура, НомерПервойСтроки),
				Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКРеквизитуСтроки("Товары", СтрокаТоваров.НомерСтроки, "Номенклатура"),
				"Объект", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСервер.ПодготовитьНаборыЗаписей(ЭтотОбъект);

	// Цены действуют с начала дня документа (периодичность регистра - день).
	Для Каждого СтрокаТоваров Из Товары Цикл
		Движение = Движения.ЦеныНоменклатуры.Добавить();
		Движение.Период = НачалоДня(Дата);
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Цена = СтрокаТоваров.Цена;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
