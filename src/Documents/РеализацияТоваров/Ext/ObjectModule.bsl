#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ЗаполнитьПоЗаказуКлиента(ДанныеЗаполнения);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновнойСклад.Получить();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат;
	КонецЕсли;

	Заказ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказКлиента, "Проведен, Статус, Контрагент, Склад");

	Если Не Заказ.Проведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Заказ %1 не проведен'"), ЗаказКлиента),
			Ссылка, "ЗаказКлиента", "Объект", Отказ);
	ИначеЕсли Заказ.Статус <> Перечисления.СтатусыЗаказовКлиентов.КОтгрузке Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Отгружать можно только заказы в статусе «К отгрузке». Статус заказа %1: «%2»'"),
				ЗаказКлиента, Заказ.Статус),
			Ссылка, "ЗаказКлиента", "Объект", Отказ);
	КонецЕсли;

	Если Заказ.Контрагент <> Контрагент Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Клиент не совпадает с клиентом заказа (%1)'"), Заказ.Контрагент),
			Ссылка, "Контрагент", "Объект", Отказ);
	КонецЕсли;

	Если Заказ.Склад <> Склад Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Склад не совпадает со складом заказа (%1): резерв заказа лежит на его складе'"),
				Заказ.Склад),
			Ссылка, "Склад", "Объект", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЦенообразованиеСервер.ЗаполнитьЦеныИПересчитатьСуммы(ЭтотОбъект);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	ЗаказКлиента = Документы.ЗаказКлиента.ПустаяСсылка();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСервер.ПодготовитьНаборыЗаписей(ЭтотОбъект);

	Данные = Документы.РеализацияТоваров.ДанныеДляПроведения(Ссылка);

	// 1. Блокировки - до чтения любых остатков.
	ПроведениеСервер.ЗаблокироватьСкладскиеОстатки(Данные.Товары);
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ЗаказыКлиентов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ЗаказКлиента", ЗаказКлиента);
		Блокировка.Заблокировать();
	КонецЕсли;

	// 2. Остатки партий и резерва читаются на момент документа - старые движения
	//    этого же документа убираем, чтобы они не попали в выборку при сдвиге даты.
	ПроведениеСервер.ОчиститьДвиженияВБазе(ЭтотОбъект);

	Момент = МоментВремени();
	СписаниеПартий = ПартионныйУчетСервер.РассчитатьСписаниеFIFO(Данные.Товары, Момент);
	Если СписаниеПартий.Нехватка.Количество() > 0 Тогда
		ПартионныйУчетСервер.СообщитьОНехваткеПартий(СписаниеПартий.Нехватка, Ссылка, Отказ);
		Возврат;
	КонецЕсли;

	// 3. Движения.
	СформироватьДвиженияТоварыНаСкладах(Данные.Товары);
	СформироватьДвиженияПартииТоваров(СписаниеПартий.Списание);
	СформироватьДвиженияПродажи(Данные.Продажи, СписаниеПартий.Списание);
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		СформироватьДвиженияПоЗаказу(Данные, Момент);
	КонецЕсли;

	ПроведениеСервер.ЗаписатьДвижения(Движения.ТоварыНаСкладах);
	ПроведениеСервер.ЗаписатьДвижения(Движения.ПартииТоваров);
	ПроведениеСервер.ЗаписатьДвижения(Движения.ТоварыВРезерве);
	ПроведениеСервер.ЗаписатьДвижения(Движения.ЗаказыКлиентов);

	// 4. Контроль после записи: свободный остаток и остатки заказа не должны уйти в минус.
	ПроведениеСервер.ПроверитьСвободныеОстатки(Данные.Товары, Ссылка, Отказ);
	ЗаказыКлиентовСервер.ПроверитьОстаткиПоЗаказу(ЗаказКлиента, Ссылка, Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоЗаказуКлиента(Заказ)

	РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Контрагент, Склад");

	ЗаказКлиента = Заказ;
	Контрагент = РеквизитыЗаказа.Контрагент;
	Склад = РеквизитыЗаказа.Склад;

	// Заполняем неотгруженным остатком, а не табличной частью заказа:
	// повторная реализация по частично отгруженному заказу не задвоит отгрузку.
	Товары.Очистить();
	Для Каждого Остаток Из ЗаказыКлиентовСервер.ОстаткиКОтгрузке(Заказ) Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = Остаток.Номенклатура;
		НоваяСтрока.Количество = Остаток.Количество;
		НоваяСтрока.Цена = Окр(Остаток.Сумма / Остаток.Количество, 2);
		НоваяСтрока.Сумма = Окр(НоваяСтрока.Количество * НоваяСтрока.Цена, 2);
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьДвиженияТоварыНаСкладах(ТаблицаТоваров)

	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Склад = СтрокаТоваров.Склад;
		Движение.Количество = СтрокаТоваров.Количество;
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьДвиженияПартииТоваров(Списание)

	Для Каждого СтрокаСписания Из Списание Цикл
		Движение = Движения.ПартииТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаСписания.Номенклатура;
		Движение.Склад = СтрокаСписания.Склад;
		Движение.Партия = СтрокаСписания.Партия;
		Движение.Количество = СтрокаСписания.Количество;
		Движение.Стоимость = СтрокаСписания.Стоимость;
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьДвиженияПродажи(ТаблицаПродаж, Списание)

	// Себестоимость по номенклатуре - сумма стоимости всех списанных партий.
	Себестоимость = Списание.Скопировать(, "Номенклатура, Стоимость");
	Себестоимость.Свернуть("Номенклатура", "Стоимость");

	Для Каждого СтрокаПродаж Из ТаблицаПродаж Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаПродаж.Номенклатура;
		Движение.Контрагент = Контрагент;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаПродаж.Количество;
		Движение.Выручка = СтрокаПродаж.Сумма;

		СтрокаСебестоимости = Себестоимость.Найти(СтрокаПродаж.Номенклатура, "Номенклатура");
		Если СтрокаСебестоимости <> Неопределено Тогда
			Движение.Себестоимость = СтрокаСебестоимости.Стоимость;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьДвиженияПоЗаказу(Данные, Момент)

	Для Каждого СтрокаПродаж Из Данные.Продажи Цикл
		Движение = Движения.ЗаказыКлиентов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.ЗаказКлиента = ЗаказКлиента;
		Движение.Номенклатура = СтрокаПродаж.Номенклатура;
		Движение.Количество = СтрокаПродаж.Количество;
		Движение.Сумма = СтрокаПродаж.Сумма;
	КонецЦикла;

	Для Каждого СтрокаРезерва Из Документы.РеализацияТоваров.РезервКСнятию(Данные.Товары, ЗаказКлиента, Момент) Цикл
		Движение = Движения.ТоварыВРезерве.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаРезерва.Номенклатура;
		Движение.Склад = СтрокаРезерва.Склад;
		Движение.ЗаказКлиента = ЗаказКлиента;
		Движение.Количество = СтрокаРезерва.Количество;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
