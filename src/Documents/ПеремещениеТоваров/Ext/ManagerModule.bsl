#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает данные документа для формирования движений.
//
// Параметры:
//  Ссылка - ДокументСсылка.ПеремещениеТоваров - проводимый документ.
//
// Возвращаемое значение:
//  Структура:
//   * Товары - ТаблицаЗначений - товары со склада-отправителя: Номенклатура, Склад, Количество.
//   * ТоварыПолучателя - ТаблицаЗначений - те же товары на складе-получателе: Номенклатура, Склад, Количество.
//
Функция ДанныеДляПроведения(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Ссылка.СкладОтправитель КАК Склад,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Ссылка.СкладОтправитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Ссылка.СкладПолучатель КАК Склад,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Ссылка.СкладПолучатель";

	Результаты = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("Товары", Результаты[0].Выгрузить());
	Данные.Вставить("ТоварыПолучателя", Результаты[1].Выгрузить());

	Возврат Данные;

КонецФункции

#КонецОбласти

#КонецЕсли
