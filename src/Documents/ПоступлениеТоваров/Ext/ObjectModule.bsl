#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновнойСклад.Получить();
	КонецЕсли;
	ОбщегоНазначения.ЗаполнитьОтветственного(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Услуги не имеют складского остатка - поступать на склад могут только товары.
	Услуги = Справочники.Номенклатура.Услуги(Товары.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого СтрокаТоваров Из Товары Цикл
		Если Услуги.Найти(СтрокаТоваров.Номенклатура) <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Строка %1: «%2» - услуга, ее нельзя оприходовать на склад'"),
					СтрокаТоваров.НомерСтроки, СтрокаТоваров.Номенклатура),
				Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКРеквизитуСтроки("Товары", СтрокаТоваров.НомерСтроки, "Номенклатура"),
				"Объект", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Цена в поступлении закупочная: прайс не подставляем, только пересчитываем суммы.
	ЦенообразованиеСервер.ПересчитатьСуммы(ЭтотОбъект);
	ОбщегоНазначения.ЗаполнитьОтветственного(ЭтотОбъект);
	ПартионныйУчетСервер.ЗапомнитьДатуДоИзменения(ЭтотОбъект);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Ответственный = Справочники.Пользователи.ПустаяСсылка();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСервер.ПодготовитьНаборыЗаписей(ЭтотОбъект);

	Данные = Документы.ПоступлениеТоваров.ДанныеДляПроведения(Ссылка);

	// Контролируем и новые ключи, и ключи прежних движений: при перепроведении строку могли
	// удалить или уменьшить, а товар из нее уже продан.
	КлючиКонтроля = ПроведениеСервер.ОбъединитьКлючи(Данные.Товары,
		ПроведениеСервер.КлючиДвиженийТоваровВБазе(Ссылка));
	ПроведениеСервер.ЗаблокироватьСкладскиеОстатки(КлючиКонтроля);

	Для Каждого СтрокаТоваров Из Данные.Товары Цикл

		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Склад = СтрокаТоваров.Склад;
		Движение.Количество = СтрокаТоваров.Количество;

		Движение = Движения.ПартииТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Склад = СтрокаТоваров.Склад;
		Движение.Партия = Ссылка;
		Движение.Количество = СтрокаТоваров.Количество;
		Движение.Стоимость = СтрокаТоваров.Стоимость;

	КонецЦикла;

	ПроведениеСервер.ЗаписатьДвижения(Движения.ТоварыНаСкладах);
	ПроведениеСервер.ЗаписатьДвижения(Движения.ПартииТоваров);

	ПроведениеСервер.ПроверитьСвободныеОстатки(КлючиКонтроля, Ссылка, Отказ);
	Документы.ПоступлениеТоваров.ПроверитьОстаткиПартии(Ссылка, Отказ);
	ПартионныйУчетСервер.ЗарегистрироватьИзменениеПартий(ЭтотОбъект, КлючиКонтроля.ВыгрузитьКолонку("Номенклатура"));

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	// Отмена проведения поступления уменьшает остаток - проверяем, что товар еще не продан.
	КлючиКонтроля = ПроведениеСервер.КлючиДвиженийТоваровВБазе(Ссылка);
	ПроведениеСервер.ЗаблокироватьСкладскиеОстатки(КлючиКонтроля);
	ПроведениеСервер.УдалитьДвижения(ЭтотОбъект);

	ПроведениеСервер.ПроверитьСвободныеОстатки(КлючиКонтроля, Ссылка, Отказ);
	Документы.ПоступлениеТоваров.ПроверитьОстаткиПартии(Ссылка, Отказ);
	ПартионныйУчетСервер.ЗарегистрироватьИзменениеПартий(ЭтотОбъект, КлючиКонтроля.ВыгрузитьКолонку("Номенклатура"));

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
