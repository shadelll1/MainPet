#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает данные документа для формирования движений.
// Строки товаров свернуты по номенклатуре; услуги отброшены (у них нет складского остатка).
//
// Параметры:
//  Ссылка - ДокументСсылка.ПоступлениеТоваров - проводимый документ.
//
// Возвращаемое значение:
//  Структура:
//   * Товары - ТаблицаЗначений - Номенклатура, Склад, Количество, Стоимость.
//
Функция ДанныеДляПроведения(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Ссылка.Склад КАК Склад,
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.Сумма) КАК Стоимость
	|ИЗ
	|	Документ.ПоступлениеТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Ссылка.Склад";

	Данные = Новый Структура;
	Данные.Вставить("Товары", Запрос.Выполнить().Выгрузить());

	Возврат Данные;

КонецФункции

// Проверяет, что товары этой партии не списаны в количестве, большем, чем теперь поступило.
// Вызывается после перезаписи движений поступления (перепроведение с уменьшением количества
// или отмена проведения).
//
// Параметры:
//  Ссылка - ДокументСсылка.ПоступлениеТоваров - партия.
//  Отказ - Булево - устанавливается в Истина при нарушении.
//
Процедура ПроверитьОстаткиПартии(Ссылка, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Партия", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПартииОстатки.Номенклатура КАК Номенклатура,
	|	ПартииОстатки.Склад КАК Склад,
	|	-ПартииОстатки.КоличествоОстаток КАК Превышение
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(, Партия = &Партия) КАК ПартииОстатки
	|ГДЕ
	|	ПартииОстатки.КоличествоОстаток < 0";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Товар «%1» из этого поступления уже списан (продан или перемещен) со склада «%2». Не хватает %3'"),
				Выборка.Номенклатура, Выборка.Склад,
				ОбщегоНазначенияКлиентСервер.ПредставлениеКоличества(Выборка.Превышение)),
			Ссылка, , , Отказ);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
