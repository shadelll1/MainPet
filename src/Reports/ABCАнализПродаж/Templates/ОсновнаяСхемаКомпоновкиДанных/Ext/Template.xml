		<field xsi:type="DataSetFieldField">
			<dataPath>ДоляНакопительно</dataPath>
			<field>ДоляНакопительно</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Доля накопительно, %</v8:content>
