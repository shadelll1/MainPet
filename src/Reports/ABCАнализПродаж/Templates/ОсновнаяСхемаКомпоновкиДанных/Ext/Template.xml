		<field xsi:type="DataSetFieldField">
			<dataPath>КлассABC</dataPath>
			<field>КлассABC</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Класс ABC</v8:content>
				</v8:item>
