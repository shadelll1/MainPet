		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Продажи.Номенклатура КАК Номенклатура,
	Продажи.ВыручкаОборот КАК Выручка
ПОМЕСТИТЬ ВТВыручка
ИЗ
	РегистрНакопления.Продажи.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , ) КАК Продажи
ГДЕ
	Продажи.ВыручкаОборот &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СУММА(ВТВыручка.Выручка) КАК Всего
ПОМЕСТИТЬ ВТИтог
ИЗ
	ВТВыручка КАК ВТВыручка
;

////////////////////////////////////////////////////////////////////////////////
// Накопительный итог: для каждой позиции — сумма выручки всех позиций,
// стоящих в рейтинге не ниже ее (при равной выручке порядок задает код).
ВЫБРАТЬ
	Текущая.Номенклатура КАК Номенклатура,
	Текущая.Выручка КАК Выручка,
	СУММА(Предыдущие.Выручка) КАК ВыручкаНакопительно
ПОМЕСТИТЬ ВТНакопительно
ИЗ
	ВТВыручка КАК Текущая
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВыручка КАК Предыдущие
		ПО (Предыдущие.Выручка &gt; Текущая.Выручка
				ИЛИ Предыдущие.Выручка = Текущая.Выручка
					И Предыдущие.Номенклатура.Код &lt;= Текущая.Номенклатура.Код)

СГРУППИРОВАТЬ ПО
	Текущая.Номенклатура,
	Текущая.Выручка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Накопительно.Номенклатура КАК Номенклатура,
	Накопительно.Выручка КАК Выручка,
	ВЫРАЗИТЬ(100 * Накопительно.Выручка / Итог.Всего КАК ЧИСЛО(15, 2)) КАК Доля,
	ВЫРАЗИТЬ(100 * Накопительно.ВыручкаНакопительно / Итог.Всего КАК ЧИСЛО(15, 2)) КАК ДоляНакопительно,
	ВЫБОР
		КОГДА Накопительно.ВыручкаНакопительно - Накопительно.Выручка &lt; 0.8 * Итог.Всего
			ТОГДА "A"
		КОГДА Накопительно.ВыручкаНакопительно - Накопительно.Выручка &lt; 0.95 * Итог.Всего
			ТОГДА "B"
		ИНАЧЕ "C"
	КОНЕЦ КАК КлассABC
ИЗ
	ВТНакопительно КАК Накопительно,
	ВТИтог КАК Итог</query>
	</dataSet>
