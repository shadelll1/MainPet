	</totalField>
	<totalField>
		<dataPath>ВаловаяПрибыль</dataPath>
		<expression>Сумма(ВаловаяПрибыль)</expression>
	</totalField>
	<totalField>
		<dataPath>Рентабельность</dataPath>
		<expression>ВЫБОР КОГДА Сумма(Выручка) = 0 ТОГДА 0 ИНАЧЕ 100 * (Сумма(Выручка) - Сумма(Себестоимость)) / Сумма(Выручка) КОНЕЦ</expression>
	</totalField>
